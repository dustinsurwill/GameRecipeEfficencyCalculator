# Copy to .env and fill in your values. Never commit .env to git.

DEBUG=true
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://recipebook:recipebook@localhost/recipebook
DATABASE_URL_SYNC=postgresql+psycopg2://recipebook:recipebook@localhost/recipebook

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-before-deploying

# GitHub OAuth
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:8000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:8000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authentik (optional — leave blank to disable)
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_BASE_URL=

# Email (for password reset — leave blank to disable)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@recipebook.app
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
